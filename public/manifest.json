{
  "manifest_version": 3,
  "name": "World Boss Alarm",
  "version": "1.1.1",
  "description": "Alarma y contador para los World Bosses de Diablo 4",

  "icons": {
    "16": "logo.png",
    "32": "logo.png",
    "48": "logo.png",
    "128": "logo.png"
  },

  "permissions": [
    "alarms",
    "storage",
    "tabs"
  ],

  "host_permissions": [
    "https://demonly.net/*"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "web_accessible_resources": [
    {
      "resources": ["logo.png"],
      "matches": ["<all_urls>"]
    }
  ],

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}