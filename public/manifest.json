{
  "manifest_version": 3,
  "name": "World Boss Alarm",
  "version": "1.0.0",
  "description": "Alarma y contador para los World Bosses de Diablo 4",

  "icons": {
    "16": "logo.png",
    "32": "logo.png",
    "48": "logo.png",
    "128": "logo.png"
  },

  "permissions": [
    "alarms",
    "tabs"
  ],

  "host_permissions": [
    "<all_urls>",
    "https://helltides.com/*",
    "https://demonly.net/*"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"]
    }
  ]
}